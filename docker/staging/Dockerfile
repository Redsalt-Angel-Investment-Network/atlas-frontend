FROM node:22-alpine

WORKDIR /app

COPY . .

RUN corepack enable
RUN pnpm install

ARG NEXT_PUBLIC_APP_NAME=cramani
ARG NEXT_PUBLIC_API_TIMEOUT=30000
ARG NEXT_PUBLIC_ENV=staging
ARG NEXT_PUBLIC_API_URL=https://staging.cramani.com/api/v1

ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_API_TIMEOUT=$NEXT_PUBLIC_API_TIMEOUT
ENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm build

EXPOSE 3000

CMD ["pnpm", "start", "--", "-H", "0.0.0.0"]